# ──────────────────────────────────────────────
# 练了么 后端环境变量模板
# 复制为 .env 后按需修改
#   cp .env.example .env
# ──────────────────────────────────────────────

# 运行环境：development / production
APP_ENV=development
SECRET_KEY=dev-secret-key-for-local

# ── 数据库 ──
# 本地开发用 SQLite（零配置）；生产切 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://lianleme:lianle123@localhost:5432/lianleme

# ── Redis（可选，不配置则降级为内存） ──
REDIS_URL=redis://localhost:6379/0

# ── MinIO 对象存储（可选，不配置则跳过） ──
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=lianleme-photos

# ── LLM 系统配置（可选，仅供无用户身份的内部任务使用） ──
# 登录用户始终使用其自行申请并在个人资料中配置的 Key，不会回退到这里
DEFAULT_LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=deepseek-v3
QWEN_VISION_MODEL=qwen-vl-plus

# Qwen3-TTS 语音合成与声音设计（API Key 留空时复用 QWEN_API_KEY）
QWEN_AUDIO_API_KEY=
QWEN_AUDIO_API_BASE=https://dashscope.aliyuncs.com/api/v1
QWEN_AUDIO_TTS_MODEL=qwen3-tts-flash
QWEN_AUDIO_TTS_VOICE=Ryan
QWEN_BYOK_TTS_VOICE=Ryan  # 用户自有 Qwen Key 使用的公共音色
QWEN_AUDIO_VOICE_DESIGN_MODEL=qwen3-tts-vd-2026-01-26

# Rhubarb Lip Sync 1.14.0（运行 backend/scripts/install_rhubarb.sh 安装）
RHUBARB_BIN=.tools/rhubarb/rhubarb
RHUBARB_TIMEOUT_SECONDS=15

# OpenAI（备选）
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o

# ── 加密 ──
# AES-256-GCM 密钥材料，用于加密用户自带的 API Key
# 非开发环境必须设置为至少 32 字节的部署专属随机值，例如：openssl rand -base64 32
AES_SECRET_KEY=dev-32-byte-secret-key-here!!!!!
